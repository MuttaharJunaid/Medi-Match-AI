# MediMatch AI Environment Variables
# The app works out-of-the-box with deterministic heuristics,
# but adding these keys unlocks the full Gemini 2.0/1.5 Flash and Qdrant Cloud pipelines.

# Google AI Studio API Key (100% Free: up to 1,500 requests/day)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# (Optional) Qdrant Cloud Managed Cluster (100% Free: 1GB cluster)
# Get your cluster URL & key at: https://cloud.qdrant.io/
QDRANT_URL=""
QDRANT_API_KEY=""

# (Optional) Langfuse Tracing & Observability (100% Free: 50,000 observations/mo)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
